---
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Café Bar Arco da Vella - Arzúa</title>
  </head>
  <body class="bg-amber-50 text-zinc-800">
    <header class="bg-green-700 text-white p-4 flex justify-between items-center">
      <h1 class="text-xl font-bold">Café Bar Arco da Vella</h1>
      <nav class="space-x-4">
        <a href="#carta" class="hover:underline">Carta</a>
        <a href="#horario" class="hover:underline">Horario</a>
        <a href="#contacto" class="hover:underline">Contacto</a>
      </nav>
    </header>

    <section class="text-center py-20 bg-gradient-to-b from-amber-100 to-white">
      <h2 class="text-4xl font-extrabold mb-4">Un lugar para descansar en el Camino</h2>
      <p class="text-lg">Raciones, bocadillos, hamburguesas y pizzas caseras en Arzúa.</p>
    </section>

    <section id="carta" class="max-w-4xl mx-auto py-16 px-4">
      <h2 class="text-2xl font-bold mb-6">🍴 Nuestra Carta</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-6 bg-white rounded-xl shadow">
          <h3 class="font-semibold text-lg">Raciones variadas</h3>
          <p>Para compartir entre amigos o familia</p>
        </div>
        <div class="p-6 bg-white rounded-xl shadow">
          <h3 class="font-semibold text-lg">Bocadillos</h3>
          <p>Clásicos del bar, con pan crujiente</p>
        </div>
        <div class="p-6 bg-white rounded-xl shadow">
          <h3 class="font-semibold text-lg">Hamburguesas</h3>
          <p>Carne casera y pan artesanal</p>
        </div>
        <div class="p-6 bg-white rounded-xl shadow">
          <h3 class="font-semibold text-lg">Pizzas caseras</h3>
          <p>Masa fina y sabrosa</p>
        </div>
      </div>
    </section>

    <footer class="bg-green-700 text-white text-center p-6">
      © {new Date().getFullYear()} Café Bar Arco da Vella - Arzúa
    </footer>
  </body>
</html>
