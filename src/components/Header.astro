---
import { getLocale, t, lurl } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
const locale = getLocale(Astro);
---
<header>
  <div class="nav container">
    <a href={lurl(locale, '')} class="logo">Arco da Vella</a>
    <nav class="menu">
      <a href={lurl(locale, '')}>{t(locale, 'nav.home', 'Inicio')}</a>
      <a href={lurl(locale, 'menu')}>{t(locale, 'nav.menu', 'Carta')}</a>
      <a href={lurl(locale, 'contacto')}>{t(locale, 'nav.contact', 'Contacto')}</a>
    </nav>
    <LanguageSwitcher />
  </div>
</header>

<style>
header {
  background: #fff;
  border-bottom: 1px solid #eee;
}
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem;
}
.logo {
  font-weight: bold;
  font-size: 1.2rem;
  color: #333;
  text-decoration: none;
}
.menu {
  display: flex;
  gap: 1.5rem;
}
.menu a {
  color: #333;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s ease;
}
.menu a:hover {
  color: #d35400; /* un tono anaranjado para hover */
}
</style>
