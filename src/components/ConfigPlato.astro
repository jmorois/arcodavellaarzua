---
import { getLocale, t, money, getAny } from "../lib/i18n";
const locale = getLocale(Astro);

// Precio por envase (para llevar)
const ENVASE = 0.50;

// Cargamos las medias raciones desde los locales (menu.mediasRaciones)
type Item = { nombre: string; precio: string };
const medias =
  (getAny<Item[]>(locale, "menu.mediasRaciones") ??
   getAny<Item[]>("es", "menu.mediasRaciones") ??
   []).map((x, i) => ({ id: `m${i}`, ...x }));

function parseEuro(txt: string): number {
  // "3,70 €" -> 3.70  |  "3.70 €" -> 3.70
  const cleaned = txt.replace(/[^\d,.\-]/g, "");
  // si hay coma, la tratamos como decimal
  const num = cleaned.includes(",")
    ? cleaned.replace(/\./g, "").replace(",", ".")
    : cleaned;
  const n = Number(num);
  return isNaN(n) ? 0 : n;
}
const fmt = (n: number) => money(locale, n, "EUR");
---

<div
  class="card"
  style="padding:1rem"
  id="plato-config"
  data-locale={locale}
  data-envase={ENVASE}
  data-lbl-include={t(locale,"config.panini.includedLabel","Incluido")}
  data-lbl-take={t(locale,"config.common.takeAway","Para llevar")}
  data-lbl-min2={t(locale,"config.common.minTwo","Elige 2 o más opciones")}
>
  <h3>{t(locale,"config.plato.title","Configura tu plato combinado")}</h3>

  <p style="margin:.25rem 0 .75rem 0;opacity:.9">
    {t(locale,"config.plato.note","Suma el precio de las medias raciones elegidas.")}
  </p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:.5rem">
    {medias.map((m) => (
      <label style="display:flex;align-items:center;gap:.5rem">
        <input
          type="checkbox"
          class="plato-item"
          value={m.id}
          data-nombre={m.nombre}
          data-precio={parseEuro(m.precio)}
        />
        {m.nombre} (+{m.precio})
      </label>
    ))}
  </div>

  <div style="display:flex;gap:1rem;align-items:center;margin-top:1rem">
    <label style="display:flex;align-items:center;gap:.5rem">
      <input type="checkbox" id="plato-llevar" />
      {t(locale,"config.common.takeAway","Para llevar")} (+{fmt(ENVASE)} {t(locale,"config.common.perBox","por envase")})
    </label>
  </div>

  <p id="plato-resumen" style="margin-top:1rem;opacity:.9"></p>
  <h3>
    {t(locale,"config.common.total","Total")}: <span id="plato-total-amount">{fmt(0)}</span>
  </h3>
  <div class="buttons" style="margin-top:.5rem">
    <button class="btn" id="plato-reset" type="button">{t(locale,"config.common.clear","Limpiar")}</button>
  </div>
</div>

<script type="module">
// @ts-nocheck
const root = document.getElementById('plato-config');
const locale = root?.dataset?.locale || 'es';
const ENVASE = Number(root?.dataset?.envase || 0);
const LBL_INC = root?.dataset?.lblInclude || 'Incluido';
const LBL_TAKE = root?.dataset?.lblTake || 'Para llevar';
const LBL_MIN2 = root?.dataset?.lblMin2 || 'Elige 2 o más opciones';

const nf = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR' });
const fmt = (n) => nf.format(n);

const all = Array.from(root.querySelectorAll('.plato-item'));
const chkLlevar = root.querySelector('#plato-llevar');
const outAmt = root.querySelector('#plato-total-amount');
const outRes = root.querySelector('#plato-resumen');
const btnReset = root.querySelector('#plato-reset');

function calc() {
  const sel = all.filter(x => x.checked)
                 .map(x => ({ nombre: x.dataset.nombre, precio: parseFloat(x.dataset.precio) || 0 }));

  const base = sel.reduce((s, x) => s + x.precio, 0);
  const total = base + (chkLlevar.checked ? ENVASE : 0);
  outAmt.textContent = fmt(total);

  if (sel.length === 0) {
    outRes.textContent = LBL_MIN2;
  } else {
    const items = sel.map(s => s.nombre).join(', ');
    const take = chkLlevar.checked ? ` · ${LBL_TAKE}` : '';
    outRes.textContent = `${LBL_INC}: ${items}${take}`;
  }
}

all.forEach(ch => ch.addEventListener('change', calc));
chkLlevar.addEventListener('change', calc);
btnReset.addEventListener('click', () => {
  all.forEach(ch => ch.checked = false);
  chkLlevar.checked = false;
  calc();
});

calc();
</script>
