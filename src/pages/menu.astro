  { nombre: "Completa (mixta + maíz + espárragos)", precio: "6,20 €" },
  { nombre: "Grande normal", precio: "5,50 €" },
  { nombre: "Grande mixta", precio: "6,00 €" },
  { nombre: "Grande completa", precio: "6,20 €" },
  { nombre: "Grande completa de pasta", precio: "6,00 €" },
];

/* PLATOS COMBINADOS: notas genéricas */
const combinadosNotasFallback = [
  "Elige 2 o más medias raciones para combinar.",
  "El precio del plato es la suma de las medias raciones elegidas.",
  "Para llevar: +0,50 € por envase.",
  "A partir de las 00:30 h no se hacen platos combinados.",
  "Sobres extra de kétchup o mayonesa: 0,05 €.",
];

/* ====== i18n: intenta usar listas traducidas; si no, usa fallback ES ====== */
type Item = { nombre: string; precio: string };
const raciones: Item[] = getAny(locale, 'menu.raciones') ?? racionesFallback;
const mediasRaciones: Item[] = getAny(locale, 'menu.mediasRaciones') ?? mediasRacionesFallback;
const bocadillos: Item[] = getAny(locale, 'menu.bocadillos') ?? bocadillosFallback;
const hamburguesas: Item[] = getAny(locale, 'menu.hamburguesas') ?? hamburguesasFallback;
const sandwiches: Item[] = getAny(locale, 'menu.sandwiches') ?? sandwichesFallback;
const ensaladas: Item[] = getAny(locale, 'menu.ensaladas') ?? ensaladasFallback;
const combinadosNotas: string[] = getAny(locale, 'menu.combinadosNotas') ?? combinadosNotasFallback;

/* Texto auxiliar: render nombre + comentario (parte entre paréntesis) */
type NombreInfo = { titulo: string; comentario: string };
const renderNombre = (n: string): NombreInfo => {
  if (!n.includes("(")) return { titulo: n, comentario: "" };
  const [tituloPart, rest] = n.split("(");
  const comentario = rest.replace(")", "").trim();
  return { titulo: tituloPart.trim(), comentario };
};
---

<BaseLayout title="Carta · Arco da Vella" routePath="" >
  <Fragment slot="header"><Header /></Fragment>

  <section class="container">
    <h1>{t(locale, 'menu.h1', 'Carta')}</h1>

    <!-- ===== 1) PIZZAS ===== -->
    <h2 id="pizzas">{t(locale, 'menu.pizzasHeading', 'Pizzas')}</h2>
    <p>
      {t(locale,'menu.pizzasMeta','Base: Masa fina (3,90 €) · Masa gruesa (4,70 €) + ')}
      <strong>{t(locale,'menu.pizzasMetaStrong','queso incluido 3,00 €')}</strong>.<br/>
      {t(locale,'menu.pizzasNote','Extras normales: +1,30 € · ')}
      <strong>{t(locale,'menu.pizzasNoteStrong1','Extra de queso')}</strong>
      {' / '}
      <strong>{t(locale,'menu.pizzasNoteStrong2','Cuatro quesos')}</strong>
      {t(locale,'menu.pizzasNoteTail',': +3,00 € · Gambas: +4,50 €.')}<br/>
      {t(locale,'menu.pizzasTakeAway','Para llevar: +0,50 € (envase).')}
    </p>
    <ConfigPizza />

    <!-- ===== 2) PANINIS ===== -->
    <h2 id="paninis">{t(locale, 'menu.paninisHeading', 'Paninis')}</h2>
    <p>
      {t(locale,'menu.paninisMeta','Base: Panini (queso + 1 ingrediente) 5,00 € · Extra normal: +0,80 € · Gambas: +3,50 €.')}<br/>
      {t(locale,'menu.paninisTakeAway','Para llevar: 1 envase cada 2 paninis (0,50 € / envase).')}
    </p>
    <ConfigPanini />

    <!-- ===== 3) BOCADILLOS ===== -->
    <h2>{t(locale, 'menu.bocadillosHeading', 'Bocadillos (Medio / Grande)')}</h2>
    <p style="margin-top:-.5rem;opacity:.8">
      {t(locale, 'menu.bocadillosSubnote', 'Ingrediente extra +0,60 € (tomate y huevo +0,70 €). En bocadillos con hamburguesa, cada hamburguesa extra +1,00 €.')}
    </p>
    <ul style="list-style:none;padding:0;margin:0">
      {bocadillos.map(it => {
        const info = renderNombre(it.nombre);
        return (
          <li class="card" style="padding:1rem;margin:.5rem 0">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span><strong>{info.titulo}</strong></span>
              <strong>{it.precio}</strong>
            </div>
            {info.comentario && <small style="opacity:.75">{t(locale,'menu.ingredientesLabel','Ingredientes:')} {info.comentario}</small>}
          </li>
        );
      })}
    </ul>

    <!-- ===== 4) HAMBURGUESAS ===== -->
    <h2 id="hamburguesas">{t(locale, 'menu.hamburguesasHeading', 'Hamburguesas')}</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {hamburguesas.map(it => {
        const info = renderNombre(it.nombre);
        return (
          <li class="card" style="padding:1rem;margin:.5rem 0">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span><strong>{info.titulo}</strong></span>
              <strong>{it.precio}</strong>
            </div>
            {info.comentario && <small style="opacity:.75">{t(locale,'menu.ingredientesLabel','Ingredientes:')} {info.comentario}</small>}
          </li>
        );
      })}
    </ul>

    <!-- ===== 5) SÁNDWICHES ===== -->
    <h2>{t(locale, 'menu.sandwichesHeading', 'Sándwiches')}</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {sandwiches.map(it => {
        const info = renderNombre(it.nombre);
        return (
          <li class="card" style="padding:1rem;margin:.5rem 0">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span><strong>{info.titulo}</strong></span>
              <strong>{it.precio}</strong>
            </div>
            {info.comentario && <small style="opacity:.75">{t(locale,'menu.ingredientesLabel','Ingredientes:')} {info.comentario}</small>}
          </li>
        );
      })}
    </ul>

    <!-- ===== 6) ENSALADAS ===== -->
    <h2>{t(locale, 'menu.ensaladasHeading', 'Ensaladas')}</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {ensaladas.map(it => {
        const info = renderNombre(it.nombre);
        return (
          <li class="card" style="padding:1rem;margin:.5rem 0">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span><strong>{info.titulo}</strong></span>
              <strong>{it.precio}</strong>
            </div>
            {info.comentario && <small style="opacity:.75">{t(locale,'menu.ingredientesLabel','Ingredientes:')} {info.comentario}</small>}
          </li>
        );
      })}
    </ul>

    <!-- ===== 7) RACIONES ===== -->
    <h2>{t(locale, 'menu.racionesHeading', 'Raciones')}</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {raciones.map(it => (
        <li class="card" style="display:flex;justify-content:space-between;align-items:center;padding:1rem;margin:.5rem 0">
          <span>{it.nombre}</span><strong>{it.precio}</strong>
        </li>
      ))}
    </ul>

    <!-- ===== 8) MEDIAS RACIONES ===== -->
    <h2>{t(locale, 'menu.mediasHeading', 'Medias raciones')}</h2>
    <ul style="list-style:none;padding:0;margin:0">
      {mediasRaciones.map(it => (
        <li class="card" style="display:flex;justify-content:space-between;align-items:center;padding:1rem;margin:.5rem 0">
          <span>{it.nombre}</span><strong>{it.precio}</strong>
        </li>
      ))}
    </ul>

    <!-- ===== 9) PLATOS COMBINADOS ===== -->
    <h2>{t(locale, 'menu.platosCombinadosHeading', 'Platos combinados')}</h2>
    <div class="card" style="padding:1rem;margin-bottom:.5rem">
      <ul style="margin:.25rem 0">
        {combinadosNotas.map(txt => (<li>{txt}</li>))}
      </ul>
    </div>
    <ConfigPlato />
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
/* (tus estilos originales siguen igual) */
</style>


