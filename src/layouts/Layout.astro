---
const {
  title = 'Arco da Vella – Pizzas y hamburguesas en Arzúa',
  description = 'Pizzería y hamburguesería en Arzúa. Pizza artesanal, hamburguesas caseras y comida para llevar. Ideal tras el Camino de Santiago.',
  url = 'https://www.arcodavellaarzua.com',
  image = `${new URL('/og-image.jpg', 'https://www.arcodavellaarzua.com').href}`, // súbela en /public
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD Schema.org (Restaurant) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "Arco da Vella",
      "url": url,
      "image": image,
      "telephone": "+34 000 000 000",
      "priceRange": "€",
      "servesCuisine": ["Pizza", "Hamburguesas", "Comida para llevar"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C/ Río Mera, s/n",
        "addressLocality": "Arzúa",
        "addressRegion": "A Coruña",
        "postalCode": "15810",
        "addressCountry": "ES"
      },
      "openingHours": [
        "Mo-Su 12:30-23:30"
      ],
      "hasMenu": "https://www.arcodavellaarzua.com/carta"
    })}></script>
  </head>
  <body>
    <slot />
  </body>
</html>

